{
  "name": "tfi-trmnl-bus-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:data": "npm run generate:schedules",
    "generate:schedules": "python3 scripts/generate-worker-data.py --gtfs-zip /tmp/GTFS_Realtime.zip --out src/tfi-static.generated.js --assets-dir data/assets",
    "test": "node scripts/worker-smoke-test.mjs && node scripts/worker-refresh-test.mjs",
    "test:assets": "node scripts/worker-assets-integration-test.mjs",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}


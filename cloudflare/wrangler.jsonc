{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tfi-trmnl-bus",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./data/assets",
    "binding": "TFI_SCHEDULE_ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}


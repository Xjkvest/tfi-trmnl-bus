<style>
  .tfi-layout {
    width: 100%;
    min-height: 0;
    align-items: stretch;
  }

  .tfi-layout--full {
    gap: 8px;
  }

  .tfi-layout--half-horizontal,
  .tfi-layout--half-vertical {
    gap: 8px;
  }

  .tfi-layout--quadrant {
    gap: 6px;
  }

  .tfi-min {
    min-width: 0;
  }

  .tfi-topline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    p\061 dding-bottom: 5px;
    border-bottom: 2px solid #000;
  }

  .tfi-topline--compact {
    gap: 6px;
    p\061 dding-bottom: 4px;
  }

  .tfi-kicker {
    display: block;
    font\02d size: 11px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .tfi-stop {
    display: block;
    m\061 rgin-top: 2px;
    font\02d size: 21px;
    font-weight: 900;
    line-height: 1.05;
  }

  .tfi-topline--compact .tfi-stop {
    font\02d size: 15px;
  }

  .tfi-stamp {
    display: flex;
    flex-wrap: wrap;
    justify\02d content: flex-end;
    align-items: center;
    gap: 4px;
    max-width: 230px;
  }

  .tfi-chip {
    display: inline-flex;
    align-items: center;
    justify\02d content: center;
    min-height: 18px;
    p\061 dding: 1px 5px;
    border: 1px solid #000;
    border\02d radius: 4px;
    font\02d size: 10px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .tfi-chip--dark {
    background: #000;
    color: #fff;
  }

  .tfi-hero {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 112px;
    gap: 10px;
    align-items: stretch;
    min-height: 92px;
    p\061 dding: 8px 10px;
    border: 2px solid #000;
    border\02d radius: 8px;
    background: #fff;
  }

  .tfi-hero--compact {
    grid-template-columns: 60px minmax(0, 1fr) 88px;
    gap: 8px;
    min-height: 72px;
    p\061 dding: 8px;
  }

  .tfi-route-cell {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .tfi-route {
    display: inline-flex;
    align-items: center;
    justify\02d content: center;
    min-width: 42px;
    max-width: 76px;
    min-height: 26px;
    p\061 dding: 2px 7px;
    border\02d radius: 4px;
    background: #000;
    color: #fff;
    font\02d size: 19px;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
  }

  .tfi-route--hero {
    width: 100%;
    max-width: none;
    min-height: 44px;
    font\02d size: 30px;
  }

  .tfi-route--compact {
    min-width: 36px;
    min-height: 23px;
    max-width: 58px;
    p\061 dding: 2px 5px;
    font\02d size: 16px;
  }

  .tfi-route--mini {
    min-width: 32px;
    min-height: 21px;
    max-width: 48px;
    p\061 dding: 1px 4px;
    font\02d size: 14px;
  }

  .tfi-hero-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify\02d content: center;
    gap: 5px;
  }

  .tfi-destination {
    display: block;
    font-weight: 900;
    line-height: 1.05;
  }

  .tfi-destination--hero {
    font\02d size: 24px;
  }

  .tfi-destination--compact {
    font\02d size: 18px;
  }

  .tfi-subline {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tfi-subline .label {
    min-width: 0;
  }

  .tfi-due {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-end;
    justify\02d content: center;
    gap: 4px;
    p\061 dding-left: 10px;
    border-left: 2px solid #000;
    text\02d align: right;
  }

  .tfi-due-main {
    display: block;
    font\02d size: 36px;
    font-weight: 900;
    line-height: 0.92;
    white-space: nowrap;
  }

  .tfi-due-main--compact {
    font\02d size: 25px;
  }

  .tfi-board {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid #000;
    border\02d radius: 8px;
  }

  .tfi-board-head,
  .tfi-row {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr) 82px;
    gap: 8px;
    align-items: center;
  }

  .tfi-board-head {
    min-height: 22px;
    p\061 dding: 0 10px;
    border-bottom: 1px solid #000;
    background: #f2f2f2;
  }

  .tfi-row {
    flex: 0 0 auto;
    min-height: 48px;
    p\061 dding: 5px 10px 4px;
    border-bottom: 1px solid #000;
  }

  .tfi-row:last-child {
    border-bottom: 0;
  }

  .tfi-row--compact {
    grid-template-columns: 50px minmax(0, 1fr) 64px;
    gap: 7px;
    min-height: 42px;
    p\061 dding: 4px 8px;
  }

  .tfi-row--tight {
    min-height: 34px;
    p\061 dding-top: 3px;
    p\061 dding-bottom: 3px;
  }

  .tfi-row-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .tfi-row-destination {
    display: block;
    min-width: 0;
    line-height: 1.05;
  }

  .tfi-row-meta {
    display: block;
    min-width: 0;
    color: #222;
    line-height: 1.05;
  }

  .tfi-row-headsign {
    display: block;
    min-width: 0;
    color: #222;
    line-height: 1.05;
  }

  .tfi-row-time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify\02d content: center;
    gap: 2px;
    text\02d align: right;
    white-space: nowrap;
  }

  .tfi-time-pill {
    display: inline-flex;
    align-items: center;
    justify\02d content: center;
    min-width: 56px;
    min-height: 23px;
    p\061 dding: 2px 6px;
    border\02d radius: 4px;
    background: #000;
    color: #fff;
    font\02d size: 16px;
    font-weight: 900;
    line-height: 1;
  }

  .tfi-row--compact .tfi-time-pill {
    min-width: 48px;
    min-height: 20px;
    p\061 dding: 1px 4px;
    font\02d size: 13px;
  }

  .tfi-right {
    text\02d align: right;
  }

  .tfi-titlebar-mark {
    width: 22px;
    height: 18px;
    border: 2px solid #000;
    border\02d radius: 4px;
    background:
      radial-gradient(circle at 6px 15px, #000 0, #000 2px, transparent 3px),
      radial-gradient(circle at 16px 15px, #000 0, #000 2px, transparent 3px),
      linear-gradient(#000, #000) 4px 5px / 14px 2px no-repeat;
  }

  .tfi-notice {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify\02d content: center;
    gap: 8px;
    p\061 dding: 18px;
    border: 2px solid #000;
    border\02d radius: 8px;
    background:
      repeating-linear-gradient(
        135deg,
        #fff 0,
        #fff 8px,
        #eee 8px,
        #eee 10px
      );
  }

  .tfi-quiet {
    color: #555;
  }

  .tfi-layout--full .tfi-row:nth-of-type(n+16),
  .tfi-layout--half-vertical .tfi-row:nth-of-type(n+16) {
    display: none;
  }

  @media (max-height: 560px) {
    .tfi-layout--full .tfi-row:nth-of-type(n+9) {
      display: none;
    }

    .tfi-layout--half-vertical .tfi-row:nth-of-type(n+10) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .tfi-board-head,
    .tfi-row {
      grid-template-columns: 50px minmax(0, 1fr) 66px;
      gap: 6px;
    }

    .tfi-row {
      p\061 dding-left: 8px;
      p\061 dding-right: 8px;
    }

    .tfi-route {
      min-width: 36px;
      max-width: 50px;
    }
  }
</style>

{% template tfi_header %}
  <div class="tfi-topline{% if compact %} tfi-topline--compact{% endif %}">
    <div class="tfi-min">
      <span class="tfi-kicker">TFI live departures</span>
      <span class="title{% if compact %} title--small{% else %} title--medium{% endif %} tfi-stop" data-clamp="1">
        {% if source_time_text != blank %}Feed {{ source_time_text }}{% else %}Feed pending{% endif %}
      </span>
    </div>
    <div class="tfi-stamp">
      <span class="tfi-chip tfi-chip--dark">Synced {{ generated_at_text | default: "--:--" }}</span>
      {% if count_text != blank and compact != true %}
        <span class="label label--small">{{ count_text }}</span>
      {% endif %}
    </div>
  </div>
{% endtemplate %}

{% template tfi_hero %}
  <div class="tfi-hero{% if compact %} tfi-hero--compact{% endif %}">
    <div class="tfi-route-cell">
      <span class="tfi-route tfi-route--hero{% if compact %} tfi-route--compact{% endif %}" data-value-fit="true">{{ departure.route }}</span>
    </div>
    <div class="tfi-hero-main">
      <span class="tfi-destination {% if compact %}tfi-destination--compact{% else %}tfi-destination--hero{% endif %}" data-clamp="{% if compact %}1{% else %}2{% endif %}">
        {{ departure.stop }}
      </span>
      <div class="tfi-subline">
        {% if departure.destination != blank %}
          <span class="label label--small" data-clamp="1">{{ departure.destination }}</span>
        {% endif %}
        {% if departure.stop_code != blank %}
          <span class="label label--small" data-clamp="1">
            Stop code: #{{ departure.stop_code }}
          </span>
        {% endif %}
        <span class="label label--small">{{ departure.status }}</span>
      </div>
    </div>
    <div class="tfi-due">
      <span class="value value--large tfi-due-main{% if compact %} tfi-due-main--compact{% endif %}" data-value-fit="true">{{ departure.time }}</span>
      <span class="label label--small">{{ departure.due }}</span>
    </div>
  </div>
{% endtemplate %}

{% template tfi_row %}
  <div class="tfi-row{% if compact %} tfi-row--compact{% endif %}{% if tight %} tfi-row--tight{% endif %}">
    <div class="tfi-route-cell">
      <span class="tfi-route{% if compact %} tfi-route--compact{% endif %}{% if mini %} tfi-route--mini{% endif %}" data-value-fit="true">{{ departure.route }}</span>
    </div>
    <div class="tfi-row-main">
      <span class="title title--small tfi-row-destination" data-clamp="1">{{ departure.stop }}</span>
      {% if departure.destination != blank %}
        <span class="label label--small tfi-row-headsign" data-clamp="1">{{ departure.destination }}</span>
      {% endif %}
      <span class="label label--small tfi-row-meta" data-clamp="1">
        {% if departure.stop_code != blank %}Stop code: #{{ departure.stop_code }}{% endif %}{% if departure.stop_code != blank and departure.status != blank %} / {% endif %}{{ departure.status }}
      </span>
    </div>
    <div class="tfi-row-time">
      <span class="tfi-time-pill" data-value-fit="true">{{ departure.time }}</span>
      <span class="label label--small">{{ departure.due }}</span>
    </div>
  </div>
{% endtemplate %}

{% template tfi_table_head %}
  <div class="tfi-board-head">
    <span class="label label--small">Route</span>
    <span class="label label--small">Stop</span>
    <span class="label label--small tfi-right">Time</span>
  </div>
{% endtemplate %}

{% template tfi_notice %}
  <div class="tfi-notice">
    <span class="tfi-kicker">{{ kicker | default: "TFI Bus" }}</span>
    <span class="title title--medium" data-clamp="2">{{ title }}</span>
    {% if body != blank %}
      <span class="description" data-clamp="3">{{ body }}</span>
    {% endif %}
  </div>
{% endtemplate %}

{% template tfi_title_bar %}
  <div class="title_bar">
    <span class="tfi-titlebar-mark"></span>
    <span class="title">TFI Bus</span>
    <span class="instance">{{ instance_text }}</span>
  </div>
{% endtemplate %}

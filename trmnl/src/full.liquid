{% assign payload = IDX_0 | default: nil %}
{% assign error_text = payload.error | default: error %}
{% assign generated_at_text = payload.generated_at | default: generated_at %}
{% assign date_text = payload.date | default: date %}
{% assign stops_label_text = payload.stops_label | default: stops_label %}
{% assign selected_stops = payload.stops | default: stops %}
{% assign message_text = payload.message | default: message %}
{% assign departures_list = payload.departures | default: departures %}
{% assign source_time_text = payload.source_time | default: source_time %}
{% assign show_stop = false %}
{% if selected_stops.size > 1 %}
  {% assign show_stop = true %}
{% endif %}
{% assign visible_count = departures_list.size %}
{% if visible_count > 5 %}
  {% assign visible_count = 5 %}
{% endif %}
{% assign count_text = visible_count | append: " shown" %}

<div class="layout layout--col layout--top gap--small tfi-layout tfi-layout--full">
  {% if error_text != blank %}
    {% render "tfi_notice", kicker: "Needs attention", title: "Bus departures", body: error_text %}
  {% else %}
    {% if departures_list.size > 0 %}
      {% assign first_departure = departures_list | first %}
      {% render "tfi_header", stops_label_text: stops_label_text, generated_at_text: generated_at_text, source_time_text: source_time_text, count_text: count_text %}
      {% render "tfi_hero", departure: first_departure, show_stop: show_stop %}

      <div class="tfi-board">
        {% render "tfi_table_head", show_stop: show_stop %}
        {% for departure in departures_list offset: 1 limit: 4 %}
          {% render "tfi_row", departure: departure, show_stop: show_stop %}
        {% endfor %}
      </div>
    {% else %}
      {% render "tfi_notice", kicker: "Nothing due", title: message_text, body: stops_label_text %}
    {% endif %}
  {% endif %}
</div>

{% render "tfi_title_bar", instance_text: date_text %}
